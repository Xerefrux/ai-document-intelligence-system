# Copy to .env and edit. Every setting has a working default, so an empty .env is fine.
# All names can be written with or without the DOCINTEL_ prefix only where noted.

# --- Where things live -------------------------------------------------------
DOCINTEL_DATA_DIR=data
# Leave empty to use SQLite in DATA_DIR. Any SQLAlchemy URL works for the tables;
# keyword search (FTS5) needs SQLite, see docs/DESIGN_DECISIONS.md.
DOCINTEL_DATABASE_URL=

# --- Server ------------------------------------------------------------------
DOCINTEL_HOST=127.0.0.1
DOCINTEL_PORT=8000
# Comma separated origins allowed to call the API from a browser (dev server: http://localhost:5173)
DOCINTEL_CORS_ORIGINS=
# If set, every /api request must send this value in an X-API-Key header.
DOCINTEL_API_KEY=
# Requests per minute per client (0 turns the limit off)
DOCINTEL_RATE_LIMIT_PER_MINUTE=600

# --- Uploads -----------------------------------------------------------------
DOCINTEL_MAX_UPLOAD_MB=100
DOCINTEL_MAX_FILES_PER_REQUEST=100
DOCINTEL_MAX_PDF_PAGES=3000

# --- Background workers ------------------------------------------------------
# Worker processes started together with the server. 0 = run `python -m docintel worker` yourself.
DOCINTEL_WORKERS=1

# --- OCR ---------------------------------------------------------------------
# auto = Tesseract if it is installed, otherwise RapidOCR (pip only, bundled models)
DOCINTEL_OCR_ENGINE=auto
DOCINTEL_OCR_DPI=200
# Page level OCR processes per worker (0 = automatic)
DOCINTEL_OCR_PROCESSES=0

# --- Extraction --------------------------------------------------------------
# rules  = offline rules only
# llm    = LLM only (falls back to rules if the LLM is down)
# hybrid = rules and LLM on every record, merged field by field
# auto   = rules first, LLM only when the rules result is incomplete or inconsistent
DOCINTEL_EXTRACTION_MODE=auto
# auto picks Gemini if a Gemini key is set, otherwise OpenAI if an OpenAI key is set, otherwise none
DOCINTEL_LLM_PROVIDER=auto
GEMINI_API_KEY=
# Comma separated, tried in order until the API accepts one
DOCINTEL_GEMINI_MODELS=gemini-flash-latest,gemini-2.5-flash,gemini-flash-lite-latest
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=
# Mask emails, phone numbers and IBANs before text leaves the machine
DOCINTEL_LLM_REDACT_PII=true

# --- Search ------------------------------------------------------------------
# hash = offline baseline, gemini / openai = real embedding models, none = keyword search only
DOCINTEL_EMBEDDING_PROVIDER=hash
